
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Windows Icon",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/windres.exe",
            "args": [
                "resources/app.rc",
                "-O",
                "coff",
                "-o",
                "resources/app.res"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Zombie Survival Arena",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "main.cpp",
                "src/systems/SaveManager.cpp",
                "resources/app.res",
                "-Iinclude",
                "-o",
                "ZombieSurvivalArena.exe",
                "-lsfml-graphics",
                "-lsfml-audio",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Compile Windows Icon"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
